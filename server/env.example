# b0r4-watch server — copie para .env e preencha

# LLM providers (escolha um ou mais)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...

# YouTube Music
# Cole aqui os headers exportados do navegador (json) para ytmusicapi
YTMUSIC_HEADERS_JSON=

# Segurança local
WATCH_AUTH_TOKEN=change-me-in-production

# MQTT (opcional, para integrações futuras)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Assistente de voz
# Providers: openai | mock
ASR_PROVIDER=mock
LLM_PROVIDER=mock
# Providers: openai | edge_tts | mock
TTS_PROVIDER=mock
ASSISTANT_LANGUAGE=pt-BR

# Textos usados quando providers estão em mock (para testar o fluxo)
MOCK_ASR_TEXT=tocar música
MOCK_LLM_TEXT=Claro, vou tocar sua música.
